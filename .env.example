# Kopieren nach .env: cp .env.example .env
# Diese Werte werden von docker compose beim Start eingelesen.
# .env nicht committen (.gitignore)!

# Nur localhost (empfohlen hinter Caddy / Reverse Proxy).
# Für direkten LAN-Zugriff: NEXTTIMER_BIND_ADDRESS=0.0.0.0
# Achtung: NextTimer hat keine integrierte API-Authentifizierung.
NEXTTIMER_BIND_ADDRESS=127.0.0.1
NEXTTIMER_PORT=8080

# Optional: AWTRIX NG; leer lassen, wenn nicht verwendet.
AWTRIX_URL=
AWTRIX_FINISH_EFFECT=Fireworks
# Beispiel: ColorWaves mit 0.3 und 10s
AWTRIX_FINISH_EFFECT_SPEED=1.0
AWTRIX_FINISH_DURATION=5s
AWTRIX_SYNC_LEAD=100ms

# Optional: Webhook nur bei Ablauf eines Server-Timers (POST).
# Im Container muss das Ziel über den Docker-Netzwerkpfad erreichbar sein.
TIMER_ALARM_WEBHOOK_URL=

# Abgelaufene Server-Timer so lange intern vorhalten (Minimum 5s).
TIMER_FINISHED_TTL=60s
